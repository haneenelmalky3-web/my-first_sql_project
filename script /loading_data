insert into  silver.manufacturing(
       manufacturing_key ,
        silver.manufacturing)
select 
     row_number() over( order by manufacturing_key ,
     manufacturing
from(
select distinct manufacturing  as manufacturing
from bronze.crm_automobile_dataset)t
